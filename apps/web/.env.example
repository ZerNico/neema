# Deployment template. Local development does not use this file: root commands
# go through scripts/dev.mjs, which injects this checkout's generated database,
# secrets, blob root and desktop profile. See docs/internals/development.md.

# PostgreSQL connection for the deployed instance.
DATABASE_URL=postgres://user:password@host:5432/database

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-a-long-random-string
BETTER_AUTH_URL=https://chat.example.com

# 32-byte base64 key used to encrypt provider API keys at rest
# generate: openssl rand -base64 32
PROVIDER_KEY_SECRET=change-me

# Filesystem root for uploaded attachment bytes (BlobStore). Relative paths
# resolve against the process cwd.
BLOB_STORE_ROOT=.data/storage
