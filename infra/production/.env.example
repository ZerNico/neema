# Read by compose.yaml. Generate each secret with: openssl rand -base64 32

POSTGRES_PASSWORD=change-me
SEARXNG_SECRET=change-me

# Public origin behind your reverse proxy.
BETTER_AUTH_URL=https://chat.example.com
BETTER_AUTH_SECRET=change-me
# Encrypts provider API keys at rest. Losing it loses every stored key.
PROVIDER_KEY_SECRET=change-me
