{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["config:recommended", "helpers:pinGitHubActionDigests", "docker:pinDigests"],
  // Matches pnpm's minimumReleaseAge: no PR for a release younger than a day.
  minimumReleaseAge: "1 day",
  internalChecksFilter: "strict",
  postUpdateOptions: ["pnpmDedupe"],
  lockFileMaintenance: { enabled: true },
  // The sandbox image's Python lock. Its refresh is the image's monthly update (below).
  "pip-compile": {
    managerFilePatterns: ["/^infra/sandbox-image/requirements\\.txt$/"],
    lockFileMaintenance: { enabled: true, schedule: ["* * 1 * *"] },
  },
  packageRules: [
    {
      // Every change to the sandbox image resets each chat's installs, so its updates
      // (base images, Python lock) arrive together once a month instead of one by one.
      // docs/internals/desktop.md#the-image
      groupName: "sandbox image",
      matchFileNames: ["infra/sandbox-image/**"],
      schedule: ["* * 1 * *"],
    },
    {
      // The lock is pip-compile's; the plain requirements manager would edit it by hand.
      matchManagers: ["pip_requirements"],
      matchFileNames: ["infra/sandbox-image/**"],
      enabled: false,
    },
    {
      // Every effect package shares one rc, and an rc can change the AI
      // interfaces the model client implements (AGENTS.md, Version pins), so
      // the group waits for approval on the dependency dashboard.
      groupName: "effect",
      matchPackageNames: ["effect", "@effect/**"],
      dependencyDashboardApproval: true,
    },
    {
      // Same-day rc builds kept as a matched pair, and their `-<sha>` suffixes
      // do not sort as versions. Bumped by hand; the dashboard can still ask.
      groupName: "drizzle",
      matchPackageNames: ["drizzle-orm", "drizzle-kit"],
      dependencyDashboardApproval: true,
    },
    {
      // Node majors move .node-version, the Dockerfile and engines together.
      matchDepNames: ["node"],
      matchUpdateTypes: ["major"],
      dependencyDashboardApproval: true,
    },
    {
      groupName: "GitHub Actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest"],
    },
  ],
}
