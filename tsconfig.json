{
  "extends": "./tsconfig.base.json",
  // Root-level config files only. Each package typechecks its own sources, so
  // this exists to keep `oxlint.config.ts` honest: a misspelled rule or plugin
  // name fails here rather than being silently ignored at lint time.
  "include": ["*.ts"],
  "compilerOptions": {
    "types": ["node"]
  }
}
