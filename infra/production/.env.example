# Read by compose.yaml. To write a .env with fresh secrets instead of editing
# this file, see Install in the README.

# Hex, because it ends up inside a postgres:// URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# openssl rand -hex 32
SEARXNG_SECRET=

# The address people open, served by your reverse proxy.
PUBLIC_URL=https://chat.example.com
# Signs sessions. Changing it signs everyone out. openssl rand -base64 32
AUTH_SECRET=
# Encrypts stored credentials: API keys, OAuth client secrets and integration
# accounts. Losing it loses every one of them. openssl rand -base64 32
ENCRYPTION_KEY=
