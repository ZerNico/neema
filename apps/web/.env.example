# Deployment template. Local development does not use this file: root commands
# go through scripts/dev.mjs, which injects this checkout's generated database,
# secrets, blob root and desktop profile. See docs/internals/development.md.

# PostgreSQL connection for the deployed instance.
DATABASE_URL=postgres://user:password@host:5432/database

# The address people open, served by your reverse proxy.
PUBLIC_URL=https://chat.example.com
# Signs sessions. Generate: openssl rand -base64 32
AUTH_SECRET=change-me
# Set to "force" to keep password sign-in on and lift email verification,
# whatever the admin chose, for when the identity provider or mail server is down.
# AUTH_PASSWORD_LOGIN=force

# 32-byte base64 key encrypting stored credentials (API keys, OAuth client
# secrets, integration accounts). Generate: openssl rand -base64 32
ENCRYPTION_KEY=change-me

# Filesystem root for uploaded attachment bytes (BlobStore). Relative paths
# resolve against the process cwd.
BLOB_STORE_ROOT=.data/storage

# Where the files for reading scanned PDF pages on this server are downloaded
# when an admin turns that on (about 37 MB at most).
OCR_MODEL_ROOT=.data/ocr-models
