# PostgreSQL connection
DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# Better Auth
BETTER_AUTH_SECRET=change-me-generate-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# 32-byte base64 key used to encrypt provider API keys at rest
# generate: openssl rand -base64 32
PROVIDER_KEY_SECRET=change-me

# Filesystem root for uploaded attachment bytes (BlobStore). Relative paths
# resolve against the process cwd.
BLOB_STORE_ROOT=.data/storage
