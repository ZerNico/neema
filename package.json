{
  "name": "chat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter @chat/web --filter @chat/desktop dev",
    "dev:web": "pnpm --filter @chat/web dev",
    "dev:desktop": "pnpm --filter @chat/desktop dev",
    "build": "pnpm --filter @chat/web build",
    "build:desktop": "pnpm --filter @chat/desktop build",
    "start": "pnpm --filter @chat/web start",
    "start:desktop": "pnpm --filter @chat/desktop start",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:watch": "pnpm --filter @chat/web test:watch",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "pnpm --filter @chat/web db:generate",
    "db:migrate": "pnpm --filter @chat/web db:migrate",
    "db:push": "pnpm --filter @chat/web db:push",
    "db:studio": "pnpm --filter @chat/web db:studio"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@types/node": "^26.5.0",
    "eslint-plugin-slop": "^0.1.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
