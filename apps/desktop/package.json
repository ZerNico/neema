{
  "name": "@chat/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "neema desktop shell",
  "homepage": "https://github.com/ZerNico/neema",
  "author": "Nico Franke",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "typecheck": "node scripts/compile-messages.ts && tsc --noEmit",
    "test": "node scripts/compile-messages.ts && pnpm exec vitest run",
    "dev": "node dev.mjs",
    "build": "node build.mjs",
    "start": "pnpm build && node electron-app.mjs",
    "package": "pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@chat/egress-proxy": "workspace:*",
    "microsandbox": "0.7.11"
  },
  "devDependencies": {
    "@chat/desktop-rpc": "workspace:*",
    "@types/node": "^26.6.5",
    "diff": "9.0.0",
    "effect": "catalog:",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "tldts": "7.4.19",
    "typescript": "^7.0.2"
  }
}
