{
  "name": "chat",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs all",
    "dev:setup": "node scripts/dev.mjs setup",
    "dev:setup:seeded": "node scripts/dev.mjs setup --seed",
    "dev:info": "node scripts/dev.mjs info",
    "dev:destroy": "node scripts/dev.mjs destroy",
    "dev:import": "node scripts/dev.mjs import",
    "dev:web": "node scripts/dev.mjs web",
    "dev:desktop": "node scripts/dev.mjs desktop",
    "build": "pnpm --filter @chat/web build",
    "build:desktop": "pnpm --filter @chat/desktop build",
    "start": "pnpm --filter @chat/web start",
    "start:desktop": "pnpm --filter @chat/desktop start",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:watch": "pnpm --filter @chat/web test:watch",
    "typecheck": "tsc --noEmit && pnpm -r typecheck",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "db:generate": "pnpm --filter @chat/web db:generate",
    "db:migrate": "node scripts/dev.mjs migrate",
    "db:push": "node scripts/dev.mjs push",
    "db:studio": "node scripts/dev.mjs studio"
  },
  "devDependencies": {
    "@shadcn/lint": "^0.1.0",
    "@types/node": "^26.5.0",
    "eslint-plugin-slop": "^0.1.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "portless": "0.15.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.3.4"
}
